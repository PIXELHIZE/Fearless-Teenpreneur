# Never commit your real API key.
OPENAI_API_KEY=sk-your-key-here

# This default supports Responses API web search and Structured Outputs.
OPENAI_MODEL=gpt-5.6-sol

# Optional: per-attempt API timeout in milliseconds (30,000-600,000).
OPENAI_TIMEOUT_MS=180000

# Optional: 1-30. A number explicitly written in the request takes precedence.
DEFAULT_QUESTION_COUNT=10

# Optional. If omitted, the two JSON files are saved directly to ~/Desktop.
# EXAM_OUTPUT_DIR=/absolute/path/to/existing-directory
